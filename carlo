#!/usr/bin/env python3
"""Launcher for the Carlo Brain CLI. Resolves symlinks so it works from ~/.local/bin."""
import os
import sys

REPO = os.path.dirname(os.path.realpath(__file__))
os.environ.setdefault("CARLO_REPO", REPO)
sys.path.insert(0, os.path.join(REPO, "core", "lib"))

from carlo_cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
